# llmuxd — system service (v2)
#
# Install: place at /etc/systemd/system/llmuxd.service, then:
#   systemctl daemon-reload
#   systemctl enable --now llmuxd
#
# Prereqs (handled by deploy/install.sh):
#   - 'llmux' system user + group exist
#   - /etc/llmux/ (root:llmux 0750) + /etc/llmux/config.yaml (root:llmux 0640)
#   - /var/lib/llmux/ (llmux:llmux 0750)
#   - /var/log/llmux/ (llmux:llmux 0750)
#   - /var/run/llmux/ (root:llmux 0750) — created by RuntimeDirectory= below
#
# Architecture: Grafana model. Single service user owns everything.
# Multi-tenant is application-layer (users.json + tokens.json). Daemon
# NEVER reads or writes any /home/* path — see V2-SYSTEM-AUTH-DESIGN.md
# § "$HOME principle."

[Unit]
Description=llmux orchestration daemon
Documentation=https://github.com/cordfuse/llmux
After=network.target
Wants=network-online.target

[Service]
Type=notify
User=llmux
Group=llmux
ExecStart=/usr/bin/llmuxd --system-mode --config /etc/llmux/config.yaml
Restart=on-failure
RestartSec=5

# Directories systemd creates + chowns for us
RuntimeDirectory=llmux
RuntimeDirectoryMode=0750
StateDirectory=llmux
StateDirectoryMode=0750
LogsDirectory=llmux
LogsDirectoryMode=0750

# Hardening — aggressive defaults, all safe because the daemon never
# reaches into /home or spawns user-owned processes
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true            # full deny — daemon has no business in /home
ReadWritePaths=/var/lib/llmux /var/log/llmux /var/run/llmux
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true   # not spawning per-user workers; no cgroup access needed
RestrictSUIDSGID=true       # daemon never setuid's anywhere
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Network
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Resource limits
LimitNOFILE=65536

# CapabilityBoundingSet kept empty — daemon needs no extra capabilities
# under the Grafana model. Override only if binding a privileged port (<1024):
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
