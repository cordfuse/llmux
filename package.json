{
  "name": "llmux-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "tmux-based AI agent session manager — dispatch to interactive agent CLIs via tmux send-keys",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "llmuxd": "bun --cwd packages/llmuxd src/index.ts",
    "llmux": "bun --cwd packages/llmux src/index.ts",
    "build": "bun run build:llmuxd && bun run build:llmux",
    "build:llmuxd": "cd packages/llmuxd && bun build src/index.ts --target=node --outdir=dist",
    "build:llmux": "cd packages/llmux && bun build src/index.ts --target=node --outdir=dist",
    "typecheck": "bun run typecheck:llmuxd && bun run typecheck:llmux",
    "typecheck:llmuxd": "cd packages/llmuxd && bun x tsc --noEmit",
    "typecheck:llmux": "cd packages/llmux && bun x tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/bun": "latest"
  }
}
