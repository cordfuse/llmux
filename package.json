{
  "name": "llmux-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "tmux-based AI agent dispatcher — daemon + CLI client in one binary",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "llmux": "tsx packages/llmux/src/index.ts",
    "build": "npm run build --workspace @cordfuse/orch-llmux",
    "typecheck": "npm run typecheck --workspace @cordfuse/orch-llmux"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20"
  }
}
