{
  "name": "@cordfuse/llmux",
  "version": "0.24.0",
  "description": "tmux-based AI agent dispatcher — REST/WS daemon + CLI client in one binary",
  "license": "MIT",
  "type": "module",
  "bin": {
    "llmux": "bin/llmux"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsup src/index.ts --target node20 --format esm --out-dir dist --external node-pty --external ws --external yaml --external qrcode-terminal --clean",
    "prepublishOnly": "cp ../../README.md ../../LICENSE . && npm run build",
    "postpublish": "rm -f README.md LICENSE",
    "postinstall": "node scripts/fix-pty-permissions.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1"
  },
  "keywords": [
    "tmux",
    "ai",
    "agent",
    "claude",
    "codex",
    "session-manager",
    "llm",
    "cordfuse"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cordfuse/llmux.git",
    "directory": "packages/llmux"
  },
  "homepage": "https://github.com/cordfuse/llmux#readme",
  "bugs": {
    "url": "https://github.com/cordfuse/llmux/issues"
  }
}
