{
  "name": "@cordfuse/llmuxd",
  "version": "0.2.0",
  "description": "tmux-based AI agent session manager daemon — REST API + web terminal",
  "license": "MIT",
  "type": "module",
  "bin": {
    "llmuxd": "bin/llmuxd"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=node --outdir=dist --external yaml --external qrcode-terminal --external node-pty",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "node-pty": "^1.1.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "^0.12.2"
  },
  "keywords": [
    "tmux",
    "ai",
    "agent",
    "claude",
    "codex",
    "session-manager",
    "llm",
    "cordfuse"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cordfuse/llmux.git",
    "directory": "packages/llmuxd"
  },
  "homepage": "https://github.com/cordfuse/llmux#readme",
  "bugs": {
    "url": "https://github.com/cordfuse/llmux/issues"
  }
}
